  "keywords": ["teams", "microsoft", "message", "notify", "notification", "channel", "chat", "post"],
  "config_schema": {
    "type": "object",
    "properties": {
      "team": { "type": "string", "minLength": 1, "description": "Team name" },
      "channel": { "type": "string", "minLength": 1, "description": "Channel inside the team" },
      "text": { "type": "string", "minLength": 1, "description": "Message template; {{field}} interpolates trigger data" }
    },
    "required": ["team", "channel", "text"],
    "additionalProperties": false
  },
  "input_ports": ["in"],
  "output_ports": ["out"]
}
